# Copy to .env.local and adjust.

# mock | supabase  (supabase is wired in step 7)
DATA_SOURCE=mock

# Artificial latency for the mock repository (ms) so loading states are visible.
MOCK_LATENCY_MS=250

# --- Supabase (step 7) ---
# Public: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
